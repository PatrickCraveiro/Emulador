{
  "name": "emulador",
  "productName": "Emulador",
  "version": "2.0.0",
  "description": "Launcher de jogos retrô com visual de console portátil, feito com Electron + React.",
  "main": "./out/main/index.js",
  "author": "Patrick Craveiro",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run compile && electron-builder --win",
    "build:dir": "npm run compile && electron-builder --win --dir",
    "compile": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.107.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
